{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug (CMake + gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "text": "-enable-pretty-printing"
                }
            ],
            "preLaunchTask": "build"
        }
    ],
    //"preLaunchTask": "cmake:build"
    // "preLaunchTask": "build",
    // "preLaunchTask": "CMake: build",

}